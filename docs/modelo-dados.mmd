erDiagram
  USER_ACCOUNT ||--o{ AUTH_SESSION : possui
  USER_ACCOUNT o|--o| CADASTRO_COOPERADO : vincula
  USER_ACCOUNT o|--o{ RATEIO_PERIODO : fecha
  CADASTRO_GERADOR ||--o{ TABELA_CARGA : recebe
  CADASTRO_GERADOR ||--o{ ALERTA_REJEITO : gera
  CADASTRO_COOPERADO ||--o{ TURNO : registra
  CADASTRO_COOPERADO ||--o{ PRODUCAO : registra
  CADASTRO_COOPERADO ||--o{ MEMORIA_RATEIO : recebe
  RATEIO_PERIODO ||--o{ MEMORIA_RATEIO : contem
