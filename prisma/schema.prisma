generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
  relationMode = "prisma"
}

enum UserRole {
  ADMIN
  EDITOR
  VIEWER
}

enum UserProfile {
  COOPERADO
  BALANCEIRO
  PRESIDENTE
}

enum TurnoStatus {
  ABERTO
  FECHADO
}

enum RateioStatus {
  ABERTO
  FECHADO
}

model UserAccount {
  id         String        @id @default(cuid()) @db.VarChar(30)
  cognitoSub String        @unique @map("cognito_sub") @db.VarChar(64)
  email      String        @unique @db.VarChar(255)
  name       String        @db.VarChar(100)
  role       UserRole      @default(VIEWER)
  profile    UserProfile   @default(COOPERADO)
  cooperadoId Int?         @unique @map("cooperado_id")
  active     Boolean       @default(true)
  createdAt  DateTime      @default(now()) @map("created_at")
  sessions   AuthSession[]
  cooperado  CadastroCooperados? @relation(fields: [cooperadoId], references: [idCooperado], onDelete: SetNull)
  turnosCriados RateioPeriodo[] @relation("RateioFechadoPor")

  @@map("user_accounts")
}

model AuthSession {
  id        String      @id @db.VarChar(36)
  tokenHash String      @unique @map("token_hash") @db.Char(64)
  userId    String      @map("user_id") @db.VarChar(30)
  expiresAt DateTime    @map("expires_at")
  createdAt DateTime    @default(now()) @map("created_at")
  user      UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model CadastroGeradores {
  idGerador    Int            @id @default(autoincrement()) @map("id_gerador")
  gerador      String         @db.VarChar(100)
  tipo         String         @db.VarChar(50)
  rejeito      Decimal        @db.Decimal(5, 2)
  ultimaColeta DateTime       @map("ultima_coleta") @db.Date
  statu        String         @db.VarChar(30)
  cargas       TabelaCargas[]
  alertas      AlertaRejeito[]

  @@map("cadastro_geradores")
}

model CadastroCooperados {
  idCooperado Int     @id @default(autoincrement()) @map("id_cooperado")
  nome        String  @db.VarChar(100)
  horas       Decimal @db.Decimal(6, 2)
  domingo     Decimal @db.Decimal(6, 2)
  kgTriados   Decimal @map("kg_triados") @db.Decimal(10, 2)
  situacao    String  @db.VarChar(30)
  origem      String  @default("MANUAL") @db.VarChar(20)

  @@map("cadastro_cooperados")
  conta       UserAccount?
  turnos      Turno[]
  producoes   Producao[]
  memorias    MemoriaRateio[]
}

model TabelaPrecos {
  idPreco    Int     @id @default(autoincrement()) @map("id_preco")
  material   String  @db.VarChar(50)
  precoPorKg Decimal @map("preco_por_kg") @db.Decimal(10, 2)
  mes        String  @db.VarChar(20)
  status     String  @db.VarChar(30)

  @@map("tabela_precos")
}

model TabelaCargas {
  idCarga         Int                @id @default(autoincrement()) @map("id_carga")
  geradorId       Int?               @map("gerador_id")
  gerador         String             @db.VarChar(50)
  material        String             @map("meterial") @db.VarChar(50)
  peso            Decimal            @db.Decimal(10, 2)
  rejeito         Decimal            @db.Decimal(5, 2)
  status          String             @db.VarChar(50)
  data            String             @db.VarChar(50)
  pesoSuspeito    Boolean            @default(false) @map("peso_suspeito")
  cadastroGerador CadastroGeradores? @relation(fields: [geradorId], references: [idGerador], onDelete: Restrict)

  @@map("tabela_cargas")
}

model AlertaRejeito {
  id          Int      @id @default(autoincrement())
  geradorId   Int      @map("gerador_id")
  criadoEm    DateTime @default(now()) @map("criado_em")
  cargas      Json
  lido        Boolean  @default(false)
  ativo       Boolean  @default(true)
  gerador     CadastroGeradores @relation(fields: [geradorId], references: [idGerador], onDelete: Cascade)

  @@index([geradorId, criadoEm])
  @@map("alertas_rejeito")
}

model Turno {
  id         Int           @id @default(autoincrement())
  cooperadoId Int          @map("cooperado_id")
  inicio     DateTime
  saida      DateTime?
  status     TurnoStatus   @default(ABERTO)
  cooperado  CadastroCooperados @relation(fields: [cooperadoId], references: [idCooperado], onDelete: Cascade)

  @@index([cooperadoId, inicio])
  @@index([status])
  @@map("turnos")
}

model Producao {
  id          Int       @id @default(autoincrement())
  cooperadoId Int       @map("cooperado_id")
  material    String    @db.VarChar(50)
  kg          Decimal   @db.Decimal(10, 2)
  data        DateTime  @db.Date
  cooperado   CadastroCooperados @relation(fields: [cooperadoId], references: [idCooperado], onDelete: Cascade)

  @@index([cooperadoId, data])
  @@map("producoes")
}

model RateioPeriodo {
  id           Int          @id @default(autoincrement())
  competencia  String       @unique @db.VarChar(7)
  status       RateioStatus @default(ABERTO)
  fechadoEm    DateTime?    @map("fechado_em")
  fechadoPorId String?      @map("fechado_por_id") @db.VarChar(30)
  fechadoPor   UserAccount? @relation("RateioFechadoPor", fields: [fechadoPorId], references: [id], onDelete: SetNull)
  memorias     MemoriaRateio[]

  @@map("rateio_periodos")
}

model MemoriaRateio {
  id            Int       @id @default(autoincrement())
  periodoId     Int       @map("periodo_id")
  cooperadoId   Int       @map("cooperado_id")
  horas         Decimal   @db.Decimal(8, 2)
  kgTriados     Decimal   @map("kg_triados") @db.Decimal(10, 2)
  valorHoras    Decimal   @map("valor_horas") @db.Decimal(10, 2)
  valorProducao Decimal   @map("valor_producao") @db.Decimal(10, 2)
  valorTotal    Decimal   @map("valor_total") @db.Decimal(10, 2)
  detalhes      Json?
  periodo       RateioPeriodo @relation(fields: [periodoId], references: [id], onDelete: Cascade)
  cooperado     CadastroCooperados @relation(fields: [cooperadoId], references: [idCooperado], onDelete: Restrict)

  @@unique([periodoId, cooperadoId])
  @@map("memorias_rateio")
}
